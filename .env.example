# Browser-facing RPC/WS of the Surfpool mainnet fork the app talks to.
# Hosted fork (default). For a local surfpool use http://127.0.0.1:8899 / ws://127.0.0.1:8900.
NEXT_PUBLIC_SOLANA_RPC_URL=https://rpc-devnet.solana.vanna.finance
NEXT_PUBLIC_SOLANA_WS_URL=wss://rpc-devnet.solana.vanna.finance
# Server-only RPC used by API routes (faucet / price keeper cheatcodes). Defaults to the public URL.
FORK_RPC_URL=https://rpc-devnet.solana.vanna.finance
# Deployed vanna_lending program on the fork.
NEXT_PUBLIC_VANNA_PROGRAM_ID=H37YVBG3eGtz89ofd7iDLc2PJgn12778392XeU2QJcGC
# Server-only Jupiter API key (https://portal.jup.ag). Blank = keyless lite-api (0.5 req/s shared).
JUPITER_API_KEY=
# Optional: comma-separated Jupiter dex allow-list for fork swaps.
# JUPITER_FORK_DEXES=Raydium,Raydium CLMM,Raydium CP,Orca V2,Meteora DLMM

# ── Solana Copilot (server-only) ─────────────────────────────────────────────
# MCP server. Local dev: start the MCP with AUTH_ENABLED=false and set MCP_AUTH_MODE=none
# (ignored in production). Hosted: workos + the three WORKOS_M2M_* values. Internal Cloud Run
# in solana-mcp; the app reaches it over VPC vanna-internal (COPILOT_ARCHITECTURE.md §11).
MCP_BASE_URL=http://localhost:8000/mcp
MCP_AUTH_MODE=none
WORKOS_M2M_CLIENT_ID=
WORKOS_M2M_CLIENT_SECRET=
WORKOS_M2M_TOKEN_URL=
# Optional audience (OAuth `resource`) for the M2M token.
MCP_RESOURCE=
# 32+ chars each. Session cookie key; record-encryption key (falls back to the session secret).
COPILOT_SESSION_SECRET=
COPILOT_STORE_SECRET=
# Sign-In-With-Solana domain. Set the public origin (or the domain) in production.
# Hosted app origin is https://test.solana.vanna.finance
COPILOT_PUBLIC_ORIGIN=
COPILOT_AUTH_DOMAIN=
# Firestore holds plans, conversations, limits and nonces. Unset = encrypted local files (dev only;
# production refuses to start without it). Hosted: project solana-mcp, database (default).
COPILOT_FIRESTORE_PROJECT=solana-mcp
COPILOT_FIRESTORE_DATABASE=(default)
COPILOT_FIRESTORE_COLLECTION_PREFIX=solana_copilot_
# Vertex AI (Gemini). Credentials come from ADC / the attached service account.
# Hosted Cloud Run uses the runtime SA, which has aiplatform.user on solana-mcp.
GOOGLE_CLOUD_PROJECT=solana-mcp
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
# Spending limits (defaults shown).
COPILOT_RATE_CHAT_PER_MIN=20
COPILOT_RATE_WRITE_PER_MIN=6
COPILOT_DAILY_TOKEN_CAP=2000000
COPILOT_MAX_ACTION_USD=5000
COPILOT_MAX_DAILY_USD=25000
# Protocol liquidates at 1.10; the Copilot sizes to this floor.
MIN_HEALTH_FACTOR=1.15

# Server-only mainnet RPC (fork price keeper: Scope copy; Phoenix book refresh / resync). A private
# provider (Alchemy, Helius, …) is much faster than the public endpoint and isn't rate-limited.
MAINNET_RPC_URL=
# Titan swap API key (https://portal.api.titan.exchange). Without it the Spot page quotes Jupiter only.
TITAN_API_KEY=
# Or a QuickNode Solana endpoint URL with the Titan Swap add-on enabled (the token is in the URL; leave TITAN_API_KEY empty then).
TITAN_API_URL=

# ── Risk Analytics (all optional) ────────────────────────────────────────────
# Durable scan state so restarts / new instances resume instead of rescanning (see docs/ANALYTICS_ARCHITECTURE.md).
# Unset in development = a local file under /.local; unset in production = memory only.
ANALYTICS_FIRESTORE_PROJECT=
ANALYTICS_FIRESTORE_DATABASE=(default)
ANALYTICS_FIRESTORE_COLLECTION=solana_analytics
# Scan tuning (defaults shown): look-back window (program transactions), transactions inspected per tick,
# refresh interval, parallel getTransaction calls (keep low: the fork's upstream rate-limits), and the
# pause between back-to-back scan bursts while discovery has a backlog.
ANALYTICS_MAX_SIGNATURES=5000
ANALYTICS_TICK_BUDGET=120
ANALYTICS_REFRESH_SECONDS=45
ANALYTICS_TX_CONCURRENCY=3
ANALYTICS_BACKLOG_PAUSE_MS=2000

# ── Predict (World.xyz markets on the fork; server-only) ─────────────────────
# Fork maker (co-signs every trade) and outcome_yield_pool keeper (signs merge_and_deposit): JSON
# byte arrays, e.g. Cloud Run secrets. The keeper MUST be the pool Config's keeper. Unset = read
# .cache/predict-fork-maker.json / .cache/predict-pool-keeper.json (gitignored); the maker is
# generated on first use, the keeper never is.
PREDICT_FORK_MAKER_SECRET_KEY=
PREDICT_POOL_KEEPER_SECRET_KEY=
# Optional: an existing Predict lookup table on the fork (else created by the maker and cached).
PREDICT_LUT_ADDRESS=
# Optional mainnet RPC overrides (default: MAINNET_RPC_URL, then public endpoints).
# PREDICT_MAINNET_RPC_URL=
# PREDICT_MAINNET_SCAN_RPC_URL=
# PREDICT_MAINNET_HISTORY_RPC_URL=

# ── Access gate (server-only; see docs/ACCESS_GATE.md) ───────────────────────
# Code visitors must enter before anything (pages or /api/*) is served. Unset = 2861.
ACCESS_CODE=
# HMAC key for the 30-day `vanna_access` cookie. 32+ random chars; rotate to sign everyone out.
# Unset = derived from ACCESS_CODE (works, but set a real secret in production).
ACCESS_COOKIE_SECRET=
