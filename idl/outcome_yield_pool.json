  "types": [
    {
      "name": "AllowedMarket",
      "docs": [
        "Marks a World market as eligible for pools. Closing it stops new pools; existing pools keep working."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market",
            "type": "pubkey"
          },
          {
            "name": "bump",
